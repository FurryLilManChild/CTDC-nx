diff --git a/tests/sh4/fp_mode_copies.py b/tests/sh4/fp_mode_copies.py
new file mode 100644
index 0000000..a7490d5
--- /dev/null
+++ b/tests/sh4/fp_mode_copies.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""CTDC-nx: differential check of the translator's FP-mode copies.
+
+Runs each FPU test program in two runners, one translated with FP-mode copies and one without, from
+every FPSCR.PR/SZ entry mode, and requires the same final context and memory hash from both.
+"""
+import argparse
+import os
+import subprocess
+import sys
+import tempfile
+
+PROGRAMS = [("p5_fpu", "p5_fpu.bin", "0x8c010000"), ("p7_fpuedge", "p7_fpuedge.bin", "0x8c010000")]
+# Katana default (DN=1, round toward zero) with each PR/SZ combination.
+MODES = [0x00040001, 0x000C0001, 0x00140001, 0x001C0001]
+BUF = "0x8c100000"
+
+
+def run(runner, programs_dir, name, binary, base, fpscr, out):
+    cmd = [runner, "--program", name, "--image", os.path.join(programs_dir, binary), "--base", base,
+           "--fpscr", hex(fpscr), "--reg", "r4=" + BUF, "--reg", "r15=0x8c00f400",
+           "--hash", BUF + ":0x100", "--out", out]
+    rc = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
+    body = open(out).read() if rc.returncode == 0 and os.path.exists(out) else ""
+    return rc.returncode, body
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--with", dest="with_", required=True)
+    ap.add_argument("--without", required=True)
+    ap.add_argument("--programs", required=True)
+    a = ap.parse_args()
+    failures = 0
+    with tempfile.TemporaryDirectory() as tmp:
+        for name, binary, base in PROGRAMS:
+            for fpscr in MODES:
+                r1 = run(a.with_, a.programs, name, binary, base, fpscr, os.path.join(tmp, "a.json"))
+                r2 = run(a.without, a.programs, name, binary, base, fpscr, os.path.join(tmp, "b.json"))
+                ok = r1 == r2 and r1[0] == 0
+                print(f"{name} fpscr={fpscr:#010x}: {'same' if ok else 'DIFFERENT'} (rc {r1[0]}/{r2[0]})")
+                if not ok:
+                    failures += 1
+                    print("with copies:\n" + r1[1] + "\nwithout:\n" + r2[1])
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
