@@ -81,6 +81,56 @@ target_include_directories(dream_sh4_runner PRIVATE ${_gen_dir})
 target_link_libraries(dream_sh4_runner PRIVATE dream::runtime)
 dream_target_defaults(dream_sh4_runner)
 
+# CTDC-nx: FP-mode copies (translator EmitOptions::fp_mode_copies). The FPU programs are entered
+# from outside the analysis, so their entry mode is unknown and they get one copy per FPSCR.PR/SZ
+# mode behind a dispatch. A second runner holds the same programs translated without copies (the
+# runtime-tested generic body only); the test runs both from every PR/SZ entry mode and requires
+# identical final state and memory. The in-process tests above only reach the PR=0 SZ=0 copy.
+set(_nocopy_dir ${CMAKE_CURRENT_BINARY_DIR}/gen_nocopies)
+file(MAKE_DIRECTORY ${_nocopy_dir})
+set(_nocopy_sources)
+set(_nocopy_umbrella "// Generated. Do not edit.\n#pragma once\n")
+set(_nocopy_table)
+foreach(prog p5_fpu:fpu p7_fpuedge:fpuedge)
+  string(REPLACE ":" ";" prog "${prog}")
+  list(GET prog 0 name)
+  list(GET prog 1 fn)
+  foreach(entry IN LISTS DREAM_SH4_PROGRAMS)
+    string(REPLACE "|" ";" entry "${entry}")
+    list(GET entry 0 ename)
+    if(ename STREQUAL name)
+      list(GET entry 2 base)
+      list(GET entry 3 specs)
+    endif()
+  endforeach()
+  set(src ${_nocopy_dir}/${name}.cpp)
+  set(hdr ${_nocopy_dir}/${name}.h)
+  add_custom_command(
+    OUTPUT ${src} ${hdr}
+    COMMAND dream-translate emit --image ${CMAKE_CURRENT_SOURCE_DIR}/programs/${name}.bin
+            --base ${base} --function ${specs} --no-fp-mode-copies --out ${src} --header ${hdr}
+    DEPENDS dream-translate ${CMAKE_CURRENT_SOURCE_DIR}/programs/${name}.bin
+            ${CMAKE_CURRENT_SOURCE_DIR}/programs/programs.cmake
+    COMMENT "Translating ${name} without FP-mode copies"
+    VERBATIM)
+  list(APPEND _nocopy_sources ${src})
+  string(APPEND _nocopy_umbrella "#include \"${name}.h\"\n")
+  string(APPEND _nocopy_table "    {\"${name}\", &dream::gen::${fn}},\n")
+endforeach()
+string(APPEND _nocopy_umbrella "\nnamespace dream::gen {\nstruct Program {\n    const char* name;\n    void (*entry)(dream::sh4::Ctx&, dream::Memory&);\n};\ninline constexpr Program kPrograms[] = {\n${_nocopy_table}};\n}  // namespace dream::gen\n")
+file(WRITE ${_nocopy_dir}/emitted_programs.h "${_nocopy_umbrella}")
+add_executable(dream_sh4_runner_nocopies runner.cpp ${_nocopy_sources})
+target_include_directories(dream_sh4_runner_nocopies PRIVATE ${_nocopy_dir})
+target_link_libraries(dream_sh4_runner_nocopies PRIVATE dream::runtime)
+dream_target_defaults(dream_sh4_runner_nocopies)
+find_package(Python3 COMPONENTS Interpreter)
+if(Python3_Interpreter_FOUND)
+  add_test(NAME translator.fp_mode_copies
+    COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/fp_mode_copies.py
+            --with $<TARGET_FILE:dream_sh4_runner> --without $<TARGET_FILE:dream_sh4_runner_nocopies>
+            --programs ${CMAKE_CURRENT_SOURCE_DIR}/programs)
+endif()
+
