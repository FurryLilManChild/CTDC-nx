+    // CTDC-nx: FP-mode copies. A function entered in a mode the analysis cannot pin down (only
+    // reached through pointers, or from callers that disagree) tests FPSCR.SZ / FPSCR.PR at every
+    // floating-point instruction (Crazy Taxi: 21,600 such tests, its vertex loop among them). When
+    // a body has any of those tests, it is also emitted once per possible entry mode, each copy
+    // with the mode known, and the plain entry picks the copy from FPSCR once. Resumes (resume_pc
+    // != 0) keep the generic body with its runtime tests, so a resume in the middle of a function,
+    // where the mode may have changed since entry, is exactly as before.
+    std::vector<std::string> bodies;
+    std::string clone_decls;
+    bodies.reserve(specs.size());
+    for (const auto& f : specs) {
+        FunctionEmitter fe(image, f, options, known, summaries, result);
+        fe.set_written(&written);
+        std::string body = fe.run();
+        // Only the bits this body actually tests are split on: a body that never tests PR keeps
+        // PR as it was (two copies, not four).
+        const bool split_sz = f.entry_sz_unknown && body.find("if (c.fpscr & FPSCR_SZ) {") != std::string::npos;
+        const bool split_pr = f.entry_pr_unknown && body.find("if (c.fpscr & FPSCR_PR) {") != std::string::npos;
+        if (options.fp_mode_copies && (split_sz || split_pr)) {
+            auto copy_name = [&](unsigned pr, unsigned sz) {
+                return f.name + "__pr" + std::to_string(pr) + "sz" + std::to_string(sz);
+            };
+            const unsigned pr_known = (f.fpscr_entry >> 19) & 1u, sz_known = (f.fpscr_entry >> 20) & 1u;
+            std::string copies;
+            for (unsigned pr = 0; pr < 2; ++pr) {
+                if (!split_pr && pr != pr_known)
+                    continue;
+                for (unsigned sz = 0; sz < 2; ++sz) {
+                    if (!split_sz && sz != sz_known)
+                        continue;
+                    FunctionSpec g = f;
+                    g.name = copy_name(pr, sz);
+                    if (split_pr) g.entry_pr_unknown = false;
+                    if (split_sz) g.entry_sz_unknown = false;
+                    g.fpscr_entry = (f.fpscr_entry & ~((1u << 19) | (1u << 20))) | (pr << 19) | (sz << 20);
+                    EmitResult scratch;  // counted once, under the generic body
+                    FunctionEmitter ge(image, g, options, known, summaries, scratch);
+                    ge.set_written(&written);
+                    copies += ge.run() + "\n";
+                    clone_decls += (options.parts > 1 ? "void " : "static void ") + g.name +
+                                   "__resume(Ctx& c, Memory& m, std::uint32_t resume_pc);\n";
+                    clone_decls += "void " + g.name + "(Ctx& c, Memory& m);\n";
+                }
+            }
+            auto pick = [&](unsigned pr) {
+                const unsigned p = split_pr ? pr : pr_known;
+                if (!split_sz)
+                    return copy_name(p, sz_known) + "__resume(c, m, 0);";
+                return "if (c.fpscr & FPSCR_SZ) " + copy_name(p, 1) + "__resume(c, m, 0); else " +
