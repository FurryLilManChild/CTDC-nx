@@ -0,0 +1,24 @@
+! CTDC-nx: a conditional branch into another branch's delay slot, with the floating-point size
+! mode differing between the two ways into the slot (Crazy Taxi's vertex loop, fn_0c081200).
+! Entered from outside (mode unknown), so the translator makes FP-mode copies of it.
+! r5 != 0: bf is taken into the slot; the slot and the block after it run in the entry mode.
+! r5 == 0: fschg toggles SZ, the bra's slot runs in the toggled mode, and the target restores it.
+! r4 and r7 point at scratch memory; fr0..fr3 hold values whose stored size shows the mode.
+! Hand-assembled (no SH assembler in the CTDC-nx build workspace); words in p15_slotfp.bin.
+    .text
+    .global _slotfp
+_slotfp:
+    tst     r5,r5           ! 0x2558
+    bf      slot            ! 0x8b01
+    fschg                   ! 0xf3fd
+    bra     tail            ! 0xa003
+slot:
+    fmov    fr2,@r7         ! 0xf72a (delay slot of the bra, also the bf target)
+    fmov    fr0,@r4         ! 0xf40a
+    rts                     ! 0x000b
+    nop                     ! 0x0009
+tail:
+    fmov    fr1,@r4         ! 0xf41a
+    fschg                   ! 0xf3fd
+    rts                     ! 0x000b
+    nop                     ! 0x0009
