diff --git a/render/include/dream/render/port_menu.h b/render/include/dream/render/port_menu.h
index 67fb248..f2ba3ab 100644
--- a/render/include/dream/render/port_menu.h
+++ b/render/include/dream/render/port_menu.h
@@ -40,7 +40,9 @@ struct PortOptions {
     // last finished frame stays up and the game runs on. 1 "low latency": the game waits for the
     // frame being drawn, as before switch-test24 (no frame of extra delay, slower when the GPU or
     // the render thread is behind).
-    int pacing = 0;
+    // CTDC-nx: always 1. Crazy Taxi is a 60 fps game and must show every frame it draws, so
+    // smooth is not offered and an options file cannot turn it back on (Mark, 2026-11-04).
+    int pacing = 1;
 
     std::string to_text() const;
     static PortOptions from_text(std::string_view text);
@@ -106,6 +108,8 @@ private:
     bool visible(int row) const {
         if (row == kSnapshot)
             return show_snapshot;
+        if (row == kPacing)
+            return false;  // CTDC-nx: no frame pacing choice (see PortOptions::pacing)
         return (row != kCpu && row != kGpu && row != kMem) || clock_;
     }
 
